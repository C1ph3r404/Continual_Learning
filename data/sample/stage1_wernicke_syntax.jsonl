{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0013", "text": "On Wednesday guerrillas had kidnapped a cosmetic surgeon and his wife while they were on their way home.", "tokens": ["On", "Wednesday", "guerrillas", "had", "kidnapped", "a", "cosmetic", "surgeon", "and", "his", "wife", "while", "they", "were", "on", "their", "way", "home", "."], "lemmas": ["on", "Wednesday", "guerrilla", "have", "kidnap", "a", "cosmetic", "surgeon", "and", "his", "wife", "while", "they", "be", "on", "their", "way", "home", "."], "upos": ["ADP", "PROPN", "NOUN", "AUX", "VERB", "DET", "ADJ", "NOUN", "CCONJ", "PRON", "NOUN", "SCONJ", "PRON", "AUX", "ADP", "PRON", "NOUN", "ADV", "PUNCT"], "heads": [2, 5, 5, 5, 0, 8, 8, 5, 11, 11, 8, 17, 17, 17, 17, 17, 5, 17, 5], "deprels": ["case", "obl", "nsubj", "aux", "root", "det", "amod", "obj", "cc", "nmod:poss", "conj", "mark", "nsubj", "cop", "case", "nmod:poss", "advcl", "advmod", "punct"]}
