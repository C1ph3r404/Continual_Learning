{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0019", "text": "They also killed Shaikh Hamid 'Akkab, a clan elder of a branch of the Dulaim tribe in Tikrit.", "tokens": ["They", "also", "killed", "Shaikh", "Hamid", "'Akkab", ",", "a", "clan", "elder", "of", "a", "branch", "of", "the", "Dulaim", "tribe", "in", "Tikrit", "."], "lemmas": ["they", "also", "kill", "Shaikh", "Hamid", "'Akkab", ",", "a", "clan", "elder", "of", "a", "branch", "of", "the", "Dulaim", "tribe", "in", "Tikrit", "."], "upos": ["PRON", "ADV", "VERB", "PROPN", "PROPN", "PROPN", "PUNCT", "DET", "NOUN", "NOUN", "ADP", "DET", "NOUN", "ADP", "DET", "PROPN", "NOUN", "ADP", "PROPN", "PUNCT"], "heads": [3, 3, 0, 3, 4, 4, 10, 10, 10, 4, 13, 13, 10, 17, 17, 17, 13, 19, 3, 3], "deprels": ["nsubj", "advmod", "root", "obj", "flat", "flat", "punct", "det", "compound", "appos", "case", "det", "nmod", "case", "det", "compound", "nmod", "case", "obl", "punct"]}
{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0020", "text": "His mother was also killed in the attack.", "tokens": ["His", "mother", "was", "also", "killed", "in", "the", "attack", "."], "lemmas": ["his", "mother", "be", "also", "kill", "in", "the", "attack", "."], "upos": ["PRON", "NOUN", "AUX", "ADV", "VERB", "ADP", "DET", "NOUN", "PUNCT"], "heads": [2, 5, 5, 5, 0, 8, 8, 5, 5], "deprels": ["nmod:poss", "nsubj:pass", "aux:pass", "advmod", "root", "case", "det", "obl", "punct"]}
{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0021", "text": "Two other Dulaim leaders have been killed in the past week and a half.", "tokens": ["Two", "other", "Dulaim", "leaders", "have", "been", "killed", "in", "the", "past", "week", "and", "a", "half", "."], "lemmas": ["two", "other", "Dulaim", "leader", "have", "be", "kill", "in", "the", "past", "week", "and", "a", "half", "."], "upos": ["NUM", "ADJ", "PROPN", "NOUN", "AUX", "AUX", "VERB", "ADP", "DET", "ADJ", "NOUN", "CCONJ", "DET", "NOUN", "PUNCT"], "heads": [4, 4, 4, 7, 7, 7, 0, 11, 11, 11, 7, 14, 14, 11, 7], "deprels": ["nummod", "amod", "compound", "nsubj:pass", "aux", "aux:pass", "root", "case", "det", "amod", "obl", "cc", "det", "conj", "punct"]}
{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0022", "text": "Guerrillas near Hawijah launched an attack that left 6 dead, including 4 Iraqi soldiers.", "tokens": ["Guerrillas", "near", "Hawijah", "launched", "an", "attack", "that", "left", "6", "dead", ",", "including", "4", "Iraqi", "soldiers", "."], "lemmas": ["guerrilla", "near", "Hawijah", "launch", "a", "attack", "that", "leave", "6", "dead", ",", "include", "4", "Iraqi", "soldier", "."], "upos": ["NOUN", "ADP", "PROPN", "VERB", "DET", "NOUN", "PRON", "VERB", "NUM", "ADJ", "PUNCT", "VERB", "NUM", "ADJ", "NOUN", "PUNCT"], "heads": [4, 3, 1, 0, 6, 4, 8, 6, 8, 8, 10, 15, 15, 15, 9, 4], "deprels": ["nsubj", "case", "nmod", "root", "det", "obj", "nsubj", "acl:relcl", "obj", "xcomp", "punct", "case", "nummod", "amod", "nmod", "punct"]}
{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0023", "text": "One of them was from the Jubur tribe and was deputy commander of the Hawijah garrison.", "tokens": ["One", "of", "them", "was", "from", "the", "Jubur", "tribe", "and", "was", "deputy", "commander", "of", "the", "Hawijah", "garrison", "."], "lemmas": ["one", "of", "they", "be", "from", "the", "Jubur", "tribe", "and", "be", "deputy", "commander", "of", "the", "Hawijah", "garrison", "."], "upos": ["NUM", "ADP", "PRON", "AUX", "ADP", "DET", "PROPN", "NOUN", "CCONJ", "AUX", "NOUN", "NOUN", "ADP", "DET", "PROPN", "NOUN", "PUNCT"], "heads": [8, 3, 1, 8, 8, 8, 8, 0, 12, 12, 12, 8, 16, 16, 16, 12, 8], "deprels": ["nsubj", "case", "nmod", "cop", "case", "det", "compound", "root", "cc", "cop", "compound", "conj", "case", "det", "compound", "nmod", "punct"]}
{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0024", "text": "Two hundred members of the Batawi clan of the Dulaim demonstrated in Baghdad on Friday, protesting the killing of their clan elder, Shaikh Kadhim Sarhid and 4 of his sons, by gunmen wearing Iraqi army uniforms.", "tokens": ["Two", "hundred", "members", "of", "the", "Batawi", "clan", "of", "the", "Dulaim", "demonstrated", "in", "Baghdad", "on", "Friday", ",", "protesting", "the", "killing", "of", "their", "clan", "elder", ",", "Shaikh", "Kadhim", "Sarhid", "and", "4", "of", "his", "sons", ",", "by", "gunmen", "wearing", "Iraqi", "army", "uniforms", "."], "lemmas": ["two", "hundred", "member", "of", "the", "Batawi", "clan", "of", "the", "Dulaim", "demonstrate", "in", "Baghdad", "on", "Friday", ",", "protest", "the", "killing", "of", "their", "clan", "elder", ",", "Shaikh", "Kadhim", "Sarhid", "and", "4", "of", "his", "son", ",", "by", "gunman", "wear", "Iraqi", "army", "uniform", "."], "upos": ["NUM", "NUM", "NOUN", "ADP", "DET", "PROPN", "NOUN", "ADP", "DET", "PROPN", "VERB", "ADP", "PROPN", "ADP", "PROPN", "PUNCT", "VERB", "DET", "NOUN", "ADP", "PRON", "NOUN", "NOUN", "PUNCT", "PROPN", "PROPN", "PROPN", "CCONJ", "NUM", "ADP", "PRON", "NOUN", "PUNCT", "ADP", "NOUN", "VERB", "ADJ", "NOUN", "NOUN", "PUNCT"], "heads": [2, 3, 11, 7, 7, 7, 3, 10, 10, 7, 0, 13, 11, 15, 11, 17, 11, 19, 17, 23, 23, 23, 19, 25, 23, 25, 25, 29, 23, 32, 32, 29, 35, 35, 19, 35, 39, 39, 36, 11], "deprels": ["compound", "nummod", "nsubj", "case", "det", "compound", "nmod", "case", "det", "nmod", "root", "case", "obl", "case", "obl", "punct", "advcl", "det", "obj", "case", "nmod:poss", "compound", "nmod", "punct", "appos", "flat", "flat", "cc", "conj", "case", "nmod:poss", "nmod", "punct", "case", "nmod", "acl", "amod", "compound", "obj", "punct"]}
