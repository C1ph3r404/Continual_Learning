{"sentence_id": "weblog-juancole.com_juancole_20051126063000_ENG_20051126_063000-0006", "text": "The third was being run by the head of an investment firm.", "tokens": ["The", "third", "was", "being", "run", "by", "the", "head", "of", "an", "investment", "firm", "."], "lemmas": ["the", "third", "be", "be", "run", "by", "the", "head", "of", "a", "investment", "firm", "."], "upos": ["DET", "ADJ", "AUX", "AUX", "VERB", "ADP", "DET", "NOUN", "ADP", "DET", "NOUN", "NOUN", "PUNCT"], "heads": [2, 5, 5, 5, 0, 8, 8, 5, 12, 12, 12, 8, 5], "deprels": ["det", "nsubj:pass", "aux", "aux:pass", "root", "case", "det", "obl:agent", "case", "det", "compound", "nmod", "punct"]}
